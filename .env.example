# Variables de entorno para desarrollo local
# Copia este fichero como .env.local y rellena los valores

# PIN de acceso al hogar (4-6 dígitos)
VITE_HOME_PIN=2306
HOME_PIN=2306

# Vercel Blob (obtienes estas tras crear el blob storage en Vercel)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Plant.id API (Kindwise) - identificación de plantas por foto
# Obtén tu key en https://admin.kindwise.com/
VITE_PLANT_ID_API_KEY=your_plant_id_api_key_here
